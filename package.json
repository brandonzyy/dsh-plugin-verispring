{
  "name": "dsh-plugin-verispring",
  "description": "Verispring 三角色会话架构 + 本地图谱 manon 组件：派遣规范门、scout 常驻、地图前置、子代理模型钉死、提交门、领导面限定、manon 桥接。Three-role session enforcement with a bundled local code-graph (manon) component.",
  "version": "1.2.2",
  "type": "module",
  "icon": "./icon.svg",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "agent",
    "subagent",
    "gates",
    "three-role",
    "verispring"
  ],
  "main": "./gates/dispatch-gate.js",
  "exports": {
    ".": "./gates/dispatch-gate.js",
    "./dispatch-gate": "./gates/dispatch-gate.js",
    "./codestyle-gate": "./gates/codestyle-gate.js",
    "./leader-scope": "./gates/leader-scope.js",
    "./manon-bridge": "./gates/manon-bridge.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "verispring-config.js",
    "cordis.patch.yml",
    "gates/*.js",
    "manon/manon-kg",
    "manon/requirements.txt",
    "manon/matrixone_graph",
    "manon/codeindex",
    "manon/core",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || ~4.0.5-alpha.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonzyy/dsh-plugin-verispring.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  }
}