{
  "name": "dsh-plugin-verispring",
  "description": "Verispring 三角色会话架构 + 本地知识图谱 manon，大幅度优化主会话上下文，大幅节省顶级模型API费用。",
  "version": "1.3.36",
  "type": "module",
  "icon": "./icon.svg",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "agent",
    "subagent",
    "gates",
    "three-role",
    "verispring"
  ],
  "main": "./gates/dispatch-gate.js",
  "scripts": {
    "smoke": "node scripts/smoke-test.mjs"
  },
  "exports": {
    ".": "./gates/dispatch-gate.js",
    "./dispatch-gate": "./gates/dispatch-gate.js",
    "./codestyle-gate": "./gates/codestyle-gate.js",
    "./leader-scope": "./gates/leader-scope.js",
    "./manon-bridge": "./gates/manon-bridge.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "gates/*.js",
    "gates/package.json",
    "manon/manon-kg",
    "manon/requirements.txt",
    "manon/matrixone_graph",
    "manon/codeindex",
    "manon/core",
    "!**/__pycache__",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || ~4.0.5-alpha.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonzyy/dsh-plugin-verispring.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  }
}
